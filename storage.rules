rules_version = '2';

// =============================================================================
// Aprendiz Bay — Firebase Storage Security Rules
// =============================================================================
//
// Path structure:
//
//   users/{userId}/avatar.jpg              Profile photo (public read — marketplace)
//   users/{userId}/cover.jpg               Optional cover image (public read)
//
//   tutors/{tutorId}/credentials/{file}    Tutor-uploaded verification docs (private)
//   tutors/{tutorId}/verification/{file}   Administrative verification records (admin only)
//   tutors/{tutorId}/portfolio/{file}      Public teaching portfolio media
//
//   hubs/{hubId}/materials/{file}          Shared materials for collective sessions
//   bookings/{bookingId}/materials/{file}  Lesson files (student + tutor only)
//
// Profile photos are publicly readable because the marketplace, tutor cards,
// and public profiles render photoUrl / avatarUrl via getDownloadURL in <img>.
// Verification documents must never be public. Clients use authenticated getBlob.
//
// ---------------------------------------------------------------------------
// App write-path audit
// ---------------------------------------------------------------------------
// MATCH  users/{userId}/avatar.jpg           → lib/storage/service.ts (uploadUserAvatar)
// MATCH  tutors/{tutorId}/credentials/{file} → lib/storage/service.ts (uploadTutorCredential)
//        Owner tutor may create/replace their own credential (onboarding + resubmit).
//        Administrative copies live under verification/ and are admin-only.
// ADMIN  users/{uid}/ and tutors/{uid}/ delete → POST /api/account/delete (LGPD)
// =============================================================================

service firebase.storage {
  match /b/{bucket}/o {

    // -------------------------------------------------------------------------
    // Helper functions
    // -------------------------------------------------------------------------

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated()
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == "admin";
    }

    function isTutor() {
      return isAuthenticated()
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == "tutor";
    }

    // Raster images only — never image/svg+xml or other scriptable types.
    function isSafeRasterImage() {
      return request.resource.contentType == 'image/jpeg'
        || request.resource.contentType == 'image/png'
        || request.resource.contentType == 'image/webp'
        || request.resource.contentType == 'image/gif';
    }

    function isPdf() {
      return request.resource.contentType == 'application/pdf';
    }

    function isCredentialContentType() {
      return isPdf()
        || request.resource.contentType == 'image/jpeg'
        || request.resource.contentType == 'image/png';
    }

    function isCredentialFileName(fileName) {
      return fileName.matches('^[A-Za-z0-9._-]+\\.(pdf|jpg|jpeg|png)$');
    }

    function credentialTypeMatchesName(fileName) {
      return (fileName.matches('.*\\.pdf$') && isPdf())
        || (fileName.matches('.*\\.(jpg|jpeg)$') && request.resource.contentType == 'image/jpeg')
        || (fileName.matches('.*\\.png$') && request.resource.contentType == 'image/png');
    }

    function isValidImageUpload() {
      return isSafeRasterImage()
        && request.resource.size > 0
        && request.resource.size < 5 * 1024 * 1024; // 5 MB
    }

    function isValidCredentialUpload(fileName) {
      return isCredentialContentType()
        && isCredentialFileName(fileName)
        && credentialTypeMatchesName(fileName)
        && request.resource.size > 0
        && request.resource.size < 10 * 1024 * 1024; // 10 MB
    }

    function isValidLessonMaterial() {
      return request.resource.size > 0
        && request.resource.size < 25 * 1024 * 1024 // 25 MB
        && (isSafeRasterImage()
          || isPdf()
          || request.resource.contentType == 'application/vnd.openxmlformats-officedocument.presentationml.presentation'
          || request.resource.contentType == 'application/vnd.openxmlformats-officedocument.wordprocessingml.document');
    }

    function bookingParticipant(bookingId) {
      let booking = firestore.get(/databases/(default)/documents/bookings/$(bookingId)).data;
      return isAuthenticated()
        && (booking.studentId == request.auth.uid
          || booking.tutorId == request.auth.uid
          || isAdmin());
    }

    function hubTutorOrParticipant(hubId) {
      let hub = firestore.get(/databases/(default)/documents/collectiveHubs/$(hubId)).data;
      return isAuthenticated()
        && (hub.tutorId == request.auth.uid
          || request.auth.uid in hub.confirmedStudentIds
          || isAdmin());
    }

    function isAvatarFile(fileName) {
      return fileName.matches('avatar\\.(jpg|jpeg|png|webp|gif)$');
    }

    function isCoverFile(fileName) {
      return fileName.matches('cover\\.(jpg|jpeg|png|webp|gif)$');
    }

    function isProfileMediaFile(fileName) {
      return isAvatarFile(fileName) || isCoverFile(fileName);
    }

    // -------------------------------------------------------------------------
    // User profile media (public read required by marketplace cards/profiles)
    // -------------------------------------------------------------------------

    match /users/{userId}/{fileName} {
      allow read: if isProfileMediaFile(fileName);
      allow create, update: if isOwner(userId) && isValidImageUpload() && isProfileMediaFile(fileName);
      allow delete: if (isOwner(userId) || isAdmin()) && isProfileMediaFile(fileName);
    }

    // -------------------------------------------------------------------------
    // Tutor-uploaded verification documents (never public)
    // -------------------------------------------------------------------------

    match /tutors/{tutorId}/credentials/{file} {
      allow get: if isOwner(tutorId) || isAdmin();
      allow list: if isOwner(tutorId) || isAdmin();
      // Owner may replace their own file (onboarding + resubmit after reject/changes).
      // isOwner(tutorId) prevents writing into another tutor's folder.
      allow create, update: if isOwner(tutorId) && isTutor() && isValidCredentialUpload(file);
      allow delete: if isOwner(tutorId) || isAdmin();
    }

    // -------------------------------------------------------------------------
    // Administrative verification records (tutors cannot create, replace, or delete)
    // -------------------------------------------------------------------------

    match /tutors/{tutorId}/verification/{file} {
      allow get, list: if isAdmin();
      allow create, update: if isAdmin() && isValidCredentialUpload(file);
      allow delete: if isAdmin();
    }

    // -------------------------------------------------------------------------
    // Tutor portfolio
    // -------------------------------------------------------------------------

    match /tutors/{tutorId}/portfolio/{file} {
      allow read: if true;
      allow create, update: if isOwner(tutorId) && isTutor() && isValidImageUpload();
      allow delete: if isOwner(tutorId) || isAdmin();
    }

    // -------------------------------------------------------------------------
    // Collective hub materials
    // -------------------------------------------------------------------------

    match /hubs/{hubId}/materials/{file} {
      allow read: if hubTutorOrParticipant(hubId);
      allow write: if hubTutorOrParticipant(hubId) && isValidLessonMaterial();
      allow delete: if firestore.get(/databases/(default)/documents/collectiveHubs/$(hubId)).data.tutorId
          == request.auth.uid
        || isAdmin();
    }

    // -------------------------------------------------------------------------
    // Booking lesson materials (1-on-1 or collective booking)
    // -------------------------------------------------------------------------

    match /bookings/{bookingId}/materials/{file} {
      allow read: if bookingParticipant(bookingId);
      allow write: if bookingParticipant(bookingId) && isValidLessonMaterial();
      allow delete: if bookingParticipant(bookingId);
    }

    // -------------------------------------------------------------------------
    // Deny everything else by default
    // -------------------------------------------------------------------------

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
