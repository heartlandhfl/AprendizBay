{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "project": [
    "**/*.{js,cjs,mjs,jsx,ts,cts,mts,tsx,css}",
    "!hostinger-next/**",
    "!.next/**",
    "!node_modules/**",
    "!dist-server/**",
    "!coverage/**",
    "!test-results/**",
    "!playwright-report/**"
  ],
  "entry": [
    "lib/tutors/empty-mock-stub.ts",
    "lib/tutors/empty-profile-stub.ts",
    "lib/jetsend/config.ts",
    "server/attach-next.js"
  ],
  "paths": {
    "@/lib/auth/role-server": ["./lib/auth/role-server.ts"],
    "@/lib/auth/roles": ["./lib/auth/roles.ts"],
    "@/lib/jetsend/config": ["./lib/jetsend/config.ts"]
  },
  "vitest": {
    "config": ["vitest.config.mts"]
  },
  "playwright": {
    "config": ["playwright.config.ts"]
  },
  "ignoreDependencies": ["postcss-load-config"]
}
