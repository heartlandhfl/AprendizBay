s da plataforma;"}],["$","li",null,{"children":"exibir perfis de professores;"}],["$","li",null,{"children":"permitir que alunos encontrem professores;"}],["$","li",null,{"children":"gerenciar reservas e aulas;"}],["$","li",null,{"children":"permitir comunicação entre alunos e professores;"}],["$","li",null,{"children":"processar pagamentos, cancelamentos e reembolsos;"}],["$","li",null,{"children":"disponibilizar aulas online;"}],["$","li",null,{"children":"administrar aulas coletivas;"}],["$","li",null,{"children":"permitir avaliações;"}],["$","li",null,{"children":"calcular e apresentar avaliações e classificações de professores;"}],["$","li",null,{"children":"verificar professores e informações profissionais;"}],["$","li",null,{"children":"administrar programas de indicação;"}],["$","li",null,{"children":"prevenir fraude, abuso e atividades ilícitas;"}],["$","li",null,{"children":"proteger a segurança da plataforma;"}],["$","li",null,{"children":"solucionar problemas técnicos;"}],["$","li",null,{"children":"prestar atendimento e suporte;"}],["$","li",null,{"children":"cumprir obrigações legais e regulatórias;"}],["$","li",null,{"children":"exercer e defender direitos em processos judiciais, administrativos ou arbitrais;"}],["$","li",null,{"children":"cumprir obrigações relacionadas a pagamentos, registros e questões fiscais; e"}],["$","li",null,{"children":"melhorar a segurança, estabilidade e funcionamento da plataforma."}]]}],["$","p",null,{"children":["A AprendizBay ",["$","strong",null,{"children":"não vende dados pessoais"}],"."]}]]]}],["$","section",null,{"id":"bases","className":"scroll-mt-24 space-y-3","children":[["$","h2",null,{"className":"text-xl font-semibold tracking-tight text-foreground","children":"4. Bases legais"}],[["$","p",null,{"children":"O tratamento de dados pessoais será realizado com fundamento em uma ou mais bases legais previstas na Lei Geral de Proteção de Dados Pessoais (LGPD), conforme a finalidade específica."}],["$","p",null,{"c