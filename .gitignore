# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage
/test-results/
/playwright-report/
/blob-report/
.firebase/
firebase-debug.log
firestore-debug.log
ui-debug.log
pubsub-debug.log

# next.js local cache
/.next/
/out/

# Hostinger copies git-tracked files into hbuilds, so the production UI
# output in hostinger-next/ must be committed. Ignore only webpack cache
# (100MB+ packs) and the build trace — neither is needed at runtime.
/hostinger-next/cache/
/hostinger-next/trace

# production
/build
/dist-server

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
