# Aprendiz Bay — production
# Firebase project: aprendiz-bay-prod
# Site: https://aprendizbay.com.br
#
# Copy variable names and values into Vercel → Project → Settings → Environment Variables
# scoped to Production. Do not commit real secrets here.

# --- Firebase (client) ---
# Firebase Console → aprendiz-bay-prod → Project settings → Your apps → Web app
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=aprendiz-bay-prod
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Firebase Admin (server) ---
# aprendiz-bay-prod → Service accounts → Generate new private key
FIREBASE_ADMIN_PROJECT_ID=aprendiz-bay-prod
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# --- Site URL ---
NEXT_PUBLIC_SITE_URL=https://aprendizbay.com.br

# --- Asaas (production) ---
ASAAS_API_KEY=
ASAAS_ENVIRONMENT=production
# Webhook URL: https://aprendizbay.com.br/api/payments/webhook
ASAAS_WEBHOOK_TOKEN=

# --- Mercado Pago (production credentials) ---
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
# Webhook URL: https://aprendizbay.com.br/api/mercadopago/webhook
NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY=

# --- Transactional e-mail ---
RESEND_API_KEY=
# SENDGRID_API_KEY=
EMAIL_FROM=Aprendiz Bay <noreply@aprendizbay.com.br>
NOTIFICATIONS_CRON_SECRET=

# --- Platform fee ---
PLATFORM_FEE_PERCENT=10
NEXT_PUBLIC_PLATFORM_FEE_PERCENT=10

# --- Payment provider ---
# asaas | mercadopago
PAYMENT_PROVIDER=mercadopago

# --- Observability (optional) ---
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
NEXT_PUBLIC_SENTRY_ENVIRONMENT=production
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=aprendizbay.com.br
PLAUSIBLE_DOMAIN=aprendizbay.com.br
