# Firebase Console → Project settings → General → Your apps → Web app → apiKey
NEXT_PUBLIC_FIREBASE_API_KEY=

# Firebase Console → Project settings → General → Your apps → Web app → authDomain
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=

# Firebase Console → Project settings → General → Project ID
NEXT_PUBLIC_FIREBASE_PROJECT_ID=aprendiz-bay-dev

# Firebase Console → Project settings → General → Your apps → Web app → storageBucket
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=

# Firebase Console → Project settings → General → Your apps → Web app → messagingSenderId
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=

# Firebase Console → Project settings → General → Your apps → Web app → appId
NEXT_PUBLIC_FIREBASE_APP_ID=

# Required on Hostinger for POST /api/reviews/recompute-rating and POST /api/account/delete,
# and on Vercel for the matching App Router routes / Server Actions
# Firebase Console → Project settings → Service accounts → Generate new private key → project_id
FIREBASE_ADMIN_PROJECT_ID=aprendiz-bay-dev

# Firebase Console → Project settings → Service accounts → Generate new private key → client_email
FIREBASE_ADMIN_CLIENT_EMAIL=

// Firebase Console → Project settings → Service accounts → Generate new private key → private_key (keep \n escapes on one line)
FIREBASE_ADMIN_PRIVATE_KEY=

# Production canonical URL for Open Graph previews (e.g. https://www.aprendizbay.com.br)
NEXT_PUBLIC_SITE_URL=

# Asaas Checkout — sandbox key by default. Set ASAAS_ENVIRONMENT=production to use api.asaas.com
# Quote the key: Asaas tokens start with $ and would otherwise expand in the shell
ASAAS_API_KEY=
ASAAS_ENVIRONMENT=sandbox
# Required shared secret sent by Asaas as asaas-access-token.
# Webhooks are rejected if this is empty or if the header does not match.
ASAAS_WEBHOOK_TOKEN=

# Transactional e-mail — Resend (preferred) or SendGrid. Used for pending bookings,
# confirmed lessons, 1-hour reminders, and new reviews. Skip sending if both empty.
RESEND_API_KEY=
# SENDGRID_API_KEY=
EMAIL_FROM=Aprendiz Bay <noreply@aprendizbay.com.br>
# Optional shared secret for GET/POST /api/notifications/reminders (Vercel Cron / Hostinger cron)
NOTIFICATIONS_CRON_SECRET=

# Percentage of each booking charged as the Aprendiz Bay platform fee (0-100).
# Stored as platformFee + tutorAmount on the booking document at reservation time.
# NEXT_PUBLIC_PLATFORM_FEE_PERCENT is an optional client alias; both default to 10.
PLATFORM_FEE_PERCENT=10
NEXT_PUBLIC_PLATFORM_FEE_PERCENT=10

# Sentry error tracking (client DSN is public by design; no PII is sent).
# Server uses SENTRY_DSN if set, otherwise NEXT_PUBLIC_SENTRY_DSN.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
NEXT_PUBLIC_SENTRY_ENVIRONMENT=development

# Plausible product analytics — cookie-free / LGPD-friendly.
# Custom events: sign_up, search, profile_view, booking_started, payment_completed.
# Domain is the hostname registered in Plausible (no protocol).
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
PLAUSIBLE_DOMAIN=
# Optional self-hosted script / Events API (defaults to plausible.io).
# NEXT_PUBLIC_PLAUSIBLE_SRC=https://plausible.io/js/script.manual.js
# PLAUSIBLE_API_HOST=https://plausible.io
