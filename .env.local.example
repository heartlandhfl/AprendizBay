# Firebase Console → Project settings → General → Your apps → Web app → apiKey
NEXT_PUBLIC_FIREBASE_API_KEY=

# Firebase Console → Project settings → General → Your apps → Web app → authDomain
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=

# Firebase Console → Project settings → General → Project ID
NEXT_PUBLIC_FIREBASE_PROJECT_ID=aprendiz-bay-dev

# Firebase Console → Project settings → General → Your apps → Web app → storageBucket
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=

# Firebase Console → Project settings → General → Your apps → Web app → messagingSenderId
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=

# Firebase Console → Project settings → General → Your apps → Web app → appId
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Console → Project settings → Service accounts → Generate new private key → project_id
FIREBASE_ADMIN_PROJECT_ID=aprendiz-bay-dev

# Firebase Console → Project settings → Service accounts → Generate new private key → client_email
FIREBASE_ADMIN_CLIENT_EMAIL=

# Firebase Console → Project settings → Service accounts → Generate new private key → private_key (keep \n escapes on one line)
FIREBASE_ADMIN_PRIVATE_KEY=
