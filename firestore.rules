rules_version = '2';

// =============================================================================
// Aprendiz Bay — Preliminary Firestore Security Rules
// =============================================================================
//
// Collections (proposed schema):
//
//   users/{userId}
//     role: "student" | "tutor" | "admin"
//     displayName, email, photoUrl, createdAt, updatedAt
//
//   tutors/{tutorId}                    // tutorId === users/{userId} for tutors
//     userId, name, subject, city, state, bio, about, methodology
//     individualPrice, collectivePrice, modality, isVerified, isOnline
//     verificationStatus: pending | approved | rejected | changes_requested | suspended
//     reviewedAt, reviewedBy, verificationReason, credentialFileName
//     hoursTaught, studentsServed, rating, reviewCount, createdAt, updatedAt
//     educationLevels[]?, yearsOfExperience?, hasAvailability?
//     Public search lists only isVerified tutors. credentialFileName, reviewedBy,
//     reviewedAt and verificationReason stay off public mapped cards.
//
//   tutors/{tutorId}/availability/{docId}  // weekly schedule (docId usually "weekly")
//     slots[]: { weekday: 0-6, startTime: "HH:mm", endTime: "HH:mm" }, updatedAt
//
//   collectiveHubs/{hubId}
//     tutorId, title, description, maxStudents, confirmedStudentIds[]
//     confirmedStudentCount, currentPrice, fullPrice, schedule, modality
//     status: open | full | closed | cancelled
//     subject?, tutorName?, scheduledDate?, startTime?, individualPrice?
//     createdAt, updatedAt
//     Public UI/APIs never return confirmedStudentIds — only confirmedStudentCount
//     ("Vagas disponíveis"). Client join uses a transaction + studentJoiningHub().
//
//   bookings/{bookingId}
//     studentId, tutorId, hubId?, type: "individual" | "coletivo"
//     status: "pending" | "confirmed" | "cancelled" | "completed"
//     paymentStatus?: "unpaid" | "awaiting_payment" | "paid" | "failed" | "expired"
//     paymentId?, asaasCheckoutId?, asaasCheckoutExpiresAt?, checkoutLockUntil?
//     refundId?, refundStatus?, refundAmount?, refundLockUntil?
//     scheduledAt, price, platformFee?, tutorAmount?, meetingUrl?, createdAt, updatedAt
//     slotKey?                      // individual uniqueness key tutorId_scheduledAtISO
//     completedAt?                      // set when the tutor/admin marks the lesson completed
//     lessonReminderSentAt?             // admin-only, set after the 1h reminder email
//
//   reviews/{reviewId}              // reviewId === bookingId (one review per booking)
//     tutorId, studentId, bookingId, rating, comment, createdAt
//
//   conversations/{conversationId}      // conversationId === studentId_tutorId
//     studentId, tutorId, participantIds[studentId, tutorId]
//     studentName?, tutorName?, lastMessage?, lastMessageAt?, createdAt, updatedAt
//
//   conversations/{conversationId}/messages/{messageId}
//     senderId, text, createdAt
//
//   asaasWebhookReceipts/{receiptId}    // Admin SDK only (Asaas webhook idempotency)
//     paymentId?, asaasCheckoutId?, bookingId?, event, outcome, createdAt
//
//   lessonSlots/{slotId}                // Admin SDK only (individual uniqueness lock)
//     slotId === tutorId + "_" + scheduledAt (UTC ISO)
//     tutorId, scheduledAt, scheduledAtIso, bookingId, studentId
//     status: held, type: individual, updatedAt
//
// NOTE: These rules are a starting point. Validate with the Firebase Emulator
// Suite before deploying to production.
//
// ---------------------------------------------------------------------------
// App write-path audit (MVP — fix app/admin flows; do not loosen rules here)
// ---------------------------------------------------------------------------
// MATCH  users/{uid} create          → lib/auth/service.ts (signup; role student|tutor only)
// MATCH  users/{uid} update          → lib/storage/service.ts (photoUrl, updatedAt)
// ADMIN  bookings create (individual)  → POST /api/bookings
//        Hostinger Express: server/api/bookings.js
//        Vercel / next start: app/api/bookings + lib/bookings/server.ts
//        Transaction: occupancy query (pending|confirmed) + lessonSlots/{tutorId}_{scheduledAtISO}
//        immediately before commit. Cancelled releases the slot; completed stays historical.
// MATCH  bookings create             → still student-only pending create (rules unchanged)
//        App path for individual lessons is the Admin API above, not client addDoc.
// MATCH  bookings student cancel       → unpaid client update; paid via /api/bookings/cancel + refund
//        (role from uid vs studentId/tutorId; browser actor field is ignored)
// MATCH  bookings tutor accept payment → lib/bookings/service.ts (paymentStatus, updatedAt)
// ADMIN  bookings checkout (Asaas)     → lib/payments/create-checkout.ts
//        (asaasCheckoutId, asaasCheckoutExpiresAt, checkoutLockUntil, fee split)
// ADMIN  bookings confirm (webhook)    → lib/payments/process-webhook.ts
//        (asaasWebhookReceipts + booking write in one Admin transaction; e-mail after commit)
// ADMIN  bookings lesson reminder      → lib/notifications (lessonReminderSentAt)
// MATCH  bookings tutor cancel         → unpaid client-capable; paid via /api/bookings/cancel + refund
// ADMIN  bookings tutor complete       → POST /api/bookings/complete
//        Hostinger Express: server/api/bookings.js
//        Vercel / next start: app/api/bookings/complete + lib/bookings/server.ts
//        Only the booking tutor or an admin; confirmed + paid only; sets completedAt
// MATCH  bookings tutor complete       → hardened rules (same transition as the API)
// MATCH  collectiveHubs create         → lib/hubs/service.ts (approved tutor dashboard)
// MATCH  collectiveHubs student join   → lib/hubs/service.ts (transaction: roster + count + status)
// MATCH  tutors/{tutorId}/availability  → lib/availability/service.ts (tutor dashboard)
// READ   bookings (own records only)    → students: studentId == uid; tutors: tutorId == uid; admin: all
// ADMIN  bookings occupancy             → GET /api/bookings/occupancy (slot picker; ISO start times only)
// MATCH  conversations create        → lib/conversations/service.ts (student starts thread)
// MATCH  conversations update        → lib/conversations/service.ts (lastMessage preview)
// MATCH  conversations/messages create → lib/conversations/service.ts (either participant)
// ADMIN  reviews create              → POST /api/reviews (deterministic id = bookingId)
//        Hostinger Express: server/api/reviews.js (firebase-admin; bypasses rules)
//        Vercel / next start: app/api/reviews + lib/reviews/server.ts
//        Client: lib/reviews/client.ts (never writes reviews from the browser)
// MATCH  reviews create              → hardened rules (completed booking, student + tutor match)
// ADMIN  tutors rating/reviewCount   → POST /api/reviews after create, or /recompute-rating
//        Server Action lib/reviews/actions.ts remains for Next hosts only
// ADMIN  account delete + anonymize  → POST /api/account/delete (LGPD art. 18)
//        Deletes users/{uid}; anonymizes bookings/reviews (keeps docs for integrity)
//        Hostinger Express: server/api/account.js
//        Vercel / next start: app/api/account/delete + lib/account/server.ts
// ADMIN  seed data                     → scripts/seed.ts
// MATCH  tutors/{tutorId} create     → lib/tutors/service.ts (onboarding; isVerified false, pending)
// MATCH  tutors/{tutorId} update     → lib/tutors/service.ts (avatarUrl, credentialFileName)
// ADMIN  tutors verification review  → POST /api/tutors/review (admin-only; Hostinger + Next)
// MATCH  tutors verification resubmit → POST /api/tutors/resubmit (tutor-only, changes_requested|rejected → pending)
// MATCH  Storage credentials         → lib/storage/service.ts (tutors/{id}/credentials/*)
// =============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // -------------------------------------------------------------------------
    // Helper functions
    // -------------------------------------------------------------------------

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function userExists() {
      return isAuthenticated()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function userRole() {
      return userDoc().data.role;
    }

    function isAdmin() {
      return userExists() && userRole() == "admin";
    }

    function isTutor() {
      return userExists() && userRole() == "tutor";
    }

    function isStudent() {
      return userExists() && userRole() == "student";
    }

    function isVerifiedTutor(tutorId) {
      let tutor = get(/databases/$(database)/documents/tutors/$(tutorId)).data;
      return tutor.isVerified == true
        && (!("verificationStatus" in tutor) || tutor.verificationStatus == "approved");
    }

    function verificationFieldsLocked() {
      return !request.resource.data.diff(resource.data).affectedKeys()
        .hasAny([
          "isVerified",
          "verificationStatus",
          "reviewedAt",
          "reviewedBy",
          "verificationReason"
        ]);
    }

    function tutorOwnedByAuth(tutorId) {
      return isAuthenticated()
        && get(/databases/$(database)/documents/tutors/$(tutorId)).data.userId == request.auth.uid;
    }

    function validRating() {
      return request.resource.data.rating in [1, 2, 3, 4, 5];
    }

    function unchanged(field) {
      return request.resource.data[field] == resource.data[field];
    }

    function hubStudentIds(data) {
      return data.confirmedStudentIds;
    }

    function studentJoiningHub() {
      let before = hubStudentIds(resource.data);
      let after = hubStudentIds(request.resource.data);
      let nextCount = request.resource.data.confirmedStudentCount;
      let nextStatus = request.resource.data.status;

      return isStudent()
        && resource.data.status == "open"
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(["confirmedStudentIds", "confirmedStudentCount", "updatedAt", "status"])
        && unchanged("tutorId")
        && unchanged("maxStudents")
        && unchanged("title")
        && after.size() == before.size() + 1
        && after.size() <= resource.data.maxStudents
        && nextCount == after.size()
        && request.auth.uid in after
        && !(request.auth.uid in before)
        && (after.size() < resource.data.maxStudents
          ? nextStatus == "open"
          : nextStatus == "full");
    }

    function tutorOwnsHub() {
      return isAuthenticated()
        && resource.data.tutorId == request.auth.uid
        && tutorOwnedByAuth(resource.data.tutorId);
    }

    function tutorUpdatingOwnHub() {
      return tutorOwnsHub()
        && unchanged("tutorId")
        && unchanged("confirmedStudentIds")
        && request.resource.data.maxStudents is int
        && request.resource.data.maxStudents >= 2
        && request.resource.data.maxStudents <= 20
        && request.resource.data.maxStudents >= hubStudentIds(resource.data).size()
        && request.resource.data.status in ["open", "full", "closed", "cancelled"]
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly([
            "title", "description", "maxStudents", "currentPrice", "fullPrice",
            "schedule", "modality", "status", "subject", "tutorName",
            "scheduledDate", "startTime", "individualPrice", "updatedAt"
          ]);
    }

    function approvedTutorCreatingHub() {
      let data = request.resource.data;

      return isTutor()
        && isVerifiedTutor(request.auth.uid)
        && data.tutorId == request.auth.uid
        && data.maxStudents is int
        && data.maxStudents >= 2
        && data.maxStudents <= 20
        && data.confirmedStudentIds.size() == 0
        && data.confirmedStudentCount == 0
        && data.status == "open"
        && data.currentPrice is number
        && data.currentPrice > 0
        && data.title is string
        && data.title.size() > 0;
    }

    function validAvailabilityDoc() {
      let data = request.resource.data;

      return data.keys().hasOnly(["slots", "updatedAt"])
        && data.slots is list
        && data.slots.size() <= 42;
    }

    function conversationParticipants() {
      return resource.data.participantIds;
    }

    function isConversationParticipant() {
      return isAuthenticated() && request.auth.uid in conversationParticipants();
    }

    function validConversationCreate() {
      let data = request.resource.data;

      return isStudent()
        && data.studentId == request.auth.uid
        && data.tutorId is string
        && data.studentId != data.tutorId
        && data.participantIds is list
        && data.participantIds.size() == 2
        && data.studentId in data.participantIds
        && data.tutorId in data.participantIds
        && exists(/databases/$(database)/documents/tutors/$(data.tutorId));
    }

    function validConversationUpdate() {
      return isConversationParticipant()
        && unchanged("studentId")
        && unchanged("tutorId")
        && unchanged("participantIds")
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(["lastMessage", "lastMessageAt", "updatedAt"]);
    }

    function validUserCreate(userId) {
      let data = request.resource.data;

      return isOwner(userId)
        && data.keys().hasAll(["role", "displayName", "email", "createdAt"])
        && data.keys().hasOnly([
          "role", "displayName", "email", "photoUrl", "createdAt", "updatedAt"
        ])
        && data.role in ["student", "tutor"]
        && data.email == request.auth.token.email;
    }

    function validUserSelfUpdate(userId) {
      return isOwner(userId)
        && unchanged("role")
        && unchanged("email")
        && unchanged("createdAt")
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(["displayName", "photoUrl", "updatedAt"]);
    }

    function validTutorCreate(tutorId) {
      let data = request.resource.data;

      return isTutor()
        && isOwner(tutorId)
        && data.userId == request.auth.uid
        && data.isVerified == false
        && data.keys().hasAll([
          "userId", "name", "subject", "individualPrice", "collectivePrice", "createdAt"
        ])
        && data.keys().hasOnly([
          "userId", "name", "subject", "city", "state", "bio", "about", "methodology",
          "headline", "individualPrice", "collectivePrice", "modality", "lessonTypes",
          "isVerified", "verificationStatus", "isOnline", "rating", "reviewCount",
          "avatarUrl", "avatarColor", "credentialFileName", "educationLevels",
          "yearsOfExperience", "hasAvailability", "createdAt", "updatedAt"
        ])
        && (!("verificationStatus" in data) || data.verificationStatus == "pending")
        && !("reviewedAt" in data)
        && !("reviewedBy" in data)
        && (!("rating" in data) || data.rating == 0)
        && (!("reviewCount" in data) || data.reviewCount == 0);
    }

    function validTutorSelfUpdate(tutorId) {
      return isTutor()
        && tutorOwnedByAuth(tutorId)
        && unchanged("userId")
        && unchanged("rating")
        && unchanged("reviewCount")
        && verificationFieldsLocked()
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly([
            "name", "subject", "city", "state", "bio", "about", "methodology", "headline",
            "individualPrice", "collectivePrice", "modality", "lessonTypes", "isOnline",
            "avatarUrl", "avatarColor", "credentialFileName", "educationLevels",
            "yearsOfExperience", "hasAvailability", "updatedAt"
          ]);
    }

    // -------------------------------------------------------------------------
    // users
    // -------------------------------------------------------------------------

    match /users/{userId} {
      allow get: if isAuthenticated();
      allow list: if isOwner(userId) || isAdmin();

      allow create: if validUserCreate(userId);

      allow update: if isAdmin() || validUserSelfUpdate(userId);

      allow delete: if isAdmin();
    }

    // -------------------------------------------------------------------------
    // tutors (public profiles)
    // -------------------------------------------------------------------------

    match /tutors/{tutorId} {
      // Marketplace listing is public for verified tutors only. Owners and admins
      // can still read pending/rejected/suspended profiles. Private fields
      // (credentialFileName, review meta) are omitted from public mappers.
      allow get: if resource.data.isVerified == true
        || (isAuthenticated() && resource.data.userId == request.auth.uid)
        || isAdmin();

      allow list: if isAdmin() || resource.data.isVerified == true;

      allow create: if validTutorCreate(tutorId);

      // Admin-only: isVerified, verificationStatus, reviewedAt, reviewedBy,
      // verificationReason, rating, reviewCount, hoursTaught, studentsServed.
      allow update: if isAdmin() || validTutorSelfUpdate(tutorId);

      allow delete: if isAdmin();

      match /availability/{docId} {
        allow read: if true;

        allow create, update: if isTutor()
          && tutorOwnedByAuth(tutorId)
          && validAvailabilityDoc();

        allow delete: if tutorOwnedByAuth(tutorId) || isAdmin();
      }
    }

    // -------------------------------------------------------------------------
    // collectiveHubs (turmas abertas)
    // -------------------------------------------------------------------------

    match /collectiveHubs/{hubId} {
      // Marketplace listing needs public reads. confirmedStudentIds stay on the
      // document for atomic joins; app mappers must omit the roster from UI.
      allow read: if true;

      allow create: if approvedTutorCreatingHub();

      allow update: if tutorUpdatingOwnHub()
        || studentJoiningHub()
        || isAdmin();

      allow delete: if tutorOwnsHub() || isAdmin();
    }

    // -------------------------------------------------------------------------
    // bookings
    // -------------------------------------------------------------------------

    match /bookings/{bookingId} {
      // Own records only. Occupancy for the public slot picker is served by
      // GET /api/bookings/occupancy (Admin SDK) and never exposes booking docs.
      allow read: if isAuthenticated()
        && (resource.data.studentId == request.auth.uid
          || resource.data.tutorId == request.auth.uid
          || isAdmin());

      allow create: if isStudent()
        && request.resource.data.studentId == request.auth.uid
        && request.resource.data.status == "pending"
        && request.resource.data.type in ["individual", "coletivo"]
        && request.resource.data.price is number
        && request.resource.data.price > 0
        && (!("platformFee" in request.resource.data)
          || (request.resource.data.platformFee is number
            && request.resource.data.platformFee >= 0))
        && (!("tutorAmount" in request.resource.data)
          || (request.resource.data.tutorAmount is number
            && request.resource.data.tutorAmount >= 0))
        && (!("paymentStatus" in request.resource.data)
          || request.resource.data.paymentStatus == "unpaid")
        && isVerifiedTutor(request.resource.data.tutorId);

      allow update: if isAdmin()
        || (resource.data.studentId == request.auth.uid
          && request.resource.data.status == "cancelled"
          && resource.data.status in ["pending", "confirmed"]
          && (!("paymentStatus" in resource.data)
            || resource.data.paymentStatus != "paid"))
        || (resource.data.tutorId == request.auth.uid
          && resource.data.status == "pending"
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(["paymentStatus", "updatedAt"])
          && request.resource.data.paymentStatus == "awaiting_payment"
          && unchanged("status"))
        || (resource.data.tutorId == request.auth.uid
          && resource.data.status in ["pending", "confirmed"]
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(["status", "updatedAt", "meetingUrl"])
          && request.resource.data.status == "cancelled"
          && (!("paymentStatus" in resource.data)
            || resource.data.paymentStatus != "paid"))
        || (resource.data.tutorId == request.auth.uid
          && resource.data.status == "confirmed"
          && resource.data.paymentStatus == "paid"
          && resource.data.scheduledAt <= request.time
          && request.resource.data.status == "completed"
          && request.resource.data.completedAt is timestamp
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(["status", "updatedAt", "completedAt"]));

      allow delete: if isAdmin();
    }

    // -------------------------------------------------------------------------
    // reviews
    // -------------------------------------------------------------------------

    match /reviews/{reviewId} {
      function reviewBooking() {
        return get(/databases/$(database)/documents/bookings/$(request.resource.data.bookingId)).data;
      }

      function validReviewCreate() {
        let data = request.resource.data;
        let booking = reviewBooking();

        return isStudent()
          && reviewId == data.bookingId
          && data.studentId == request.auth.uid
          && data.tutorId == booking.tutorId
          && data.bookingId is string
          && data.bookingId.size() > 0
          && data.comment is string
          && data.comment.size() > 0
          && data.comment.size() <= 2000
          && data.createdAt is timestamp
          && validRating()
          && exists(/databases/$(database)/documents/bookings/$(data.bookingId))
          && booking.studentId == request.auth.uid
          && booking.status == "completed";
      }

      function validReviewUpdate() {
        return isAuthenticated()
          && resource.data.studentId == request.auth.uid
          && unchanged("bookingId")
          && unchanged("tutorId")
          && unchanged("studentId")
          && validRating()
          && request.resource.data.comment is string
          && request.resource.data.comment.size() > 0
          && request.resource.data.comment.size() <= 2000
          && request.time < resource.data.createdAt + duration.value(48, "h");
      }

      allow read: if true;

      allow create: if validReviewCreate();

      allow update: if isAdmin() || validReviewUpdate();

      allow delete: if isAdmin();
    }

    // -------------------------------------------------------------------------
    // conversations (student ↔ tutor) and messages
    // -------------------------------------------------------------------------

    match /conversations/{conversationId} {
      function conversationParent() {
        return get(/databases/$(database)/documents/conversations/$(conversationId)).data;
      }

      function isMessageParticipant() {
        return isAuthenticated()
          && request.auth.uid in conversationParent().participantIds;
      }

      function validMessageCreate() {
        let data = request.resource.data;

        return isMessageParticipant()
          && data.senderId == request.auth.uid
          && data.text is string
          && data.text.size() > 0
          && data.text.size() <= 2000;
      }

      allow read: if isConversationParticipant();

      allow create: if validConversationCreate();

      allow update: if validConversationUpdate();

      allow delete: if false;

      match /messages/{messageId} {
        allow read: if isMessageParticipant();

        allow create: if validMessageCreate();

        allow update, delete: if false;
      }
    }

    // -------------------------------------------------------------------------
    // subjects (read-only catalog)
    // -------------------------------------------------------------------------

    match /subjects/{subjectId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Asaas webhook receipts — Admin SDK only (lib/payments/process-webhook.ts)
    match /asaasWebhookReceipts/{receiptId} {
      allow read, write: if false;
    }

    // Individual lesson uniqueness lock — Admin SDK only
    // (lib/bookings/create-booking.js). Clients cannot read or write.
    match /lessonSlots/{slotId} {
      allow read, write: if false;
    }

    // -------------------------------------------------------------------------
    // Deny everything else by default
    // -------------------------------------------------------------------------

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
