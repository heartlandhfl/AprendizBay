rules_version = '2';

// =============================================================================
// Aprendiz Bay — Preliminary Firestore Security Rules
// =============================================================================
//
// Collections (proposed schema):
//
//   users/{userId}                      // PRIVATE account document
//     Public profile:     displayName, photoUrl  → copied to public/profile
//     Private account:    email, createdAt, updatedAt
//     Security-sensitive: role ("student" | "tutor" | "admin")
//     Administrative:     admin list/update/delete; role changes
//     Get is owner or admin only. Marketplace must NOT read this doc.
//
//   users/{userId}/public/profile       // PUBLIC display fields only
//     displayName, photoUrl, updatedAt
//     Authenticated get. No email, role, or timestamps from the parent.
//
//   tutors/{tutorId}                    // tutorId === users/{userId} for tutors
//     userId, name, subject, city, state, bio, about, methodology
//     individualPrice, collectivePrice, modality, isVerified, isOnline
//     verificationStatus: pending | approved | rejected | changes_requested | suspended
//     reviewedAt, reviewedBy, verificationReason, credentialFileName
//     hoursTaught, studentsServed, rating, reviewCount, createdAt, updatedAt
//     educationLevels[]?, yearsOfExperience?, hasAvailability?
//     Public search lists only isVerified tutors. credentialFileName, reviewedBy,
//     reviewedAt and verificationReason stay off public mapped cards.
//
//   tutors/{tutorId}/availability/{docId}  // weekly schedule (docId usually "weekly")
//     slots[]: { weekday: 0-6, startTime: "HH:mm", endTime: "HH:mm" }, updatedAt
//
//   collectiveHubs/{hubId}              // PUBLIC marketplace document
//     tutorId, title, description, maxStudents, confirmedStudentCount
//     currentPrice, fullPrice, schedule, modality
//     status: open | full | closed | cancelled
//     subject?, tutorName?, scheduledDate?, startTime?, individualPrice?
//     createdAt, updatedAt
//     Occupancy is the count only ("Vagas disponíveis"). No student roster.
//
//   collectiveHubs/{hubId}/participants/{studentId}  // PRIVATE roster
//     studentId, joinedAt
//     Readable by that student, the hub tutor, or an admin.
//     Writes are Admin SDK only (POST /api/hubs/join).
//
//   bookings/{bookingId}
//     studentId, tutorId, hubId?, type: "individual" | "coletivo"
//     status: "pending" | "confirmed" | "cancelled" | "completed"
//     paymentStatus?: "unpaid" | "awaiting_payment" | "paid" | "failed" | "expired"
//     paymentId?, asaasCheckoutId?, asaasCheckoutExpiresAt?, checkoutLockUntil?
//     refundId?, refundStatus?, refundAmount?, refundLockUntil?
//     scheduledAt, price, platformFee?, tutorAmount?, meetingUrl?, createdAt, updatedAt
//     slotKey?                      // individual uniqueness key tutorId_scheduledAtISO
//     completedAt?                      // set when the tutor/admin marks the lesson completed
//     lessonReminderSentAt?             // admin-only, set after the 1h reminder email
//
//   reviews/{reviewId}              // reviewId === bookingId (one review per booking)
//     tutorId, studentId, bookingId, rating, comment, createdAt
//
//   conversations/{conversationId}      // conversationId === studentId_tutorId
//     studentId, tutorId, participantIds[studentId, tutorId]
//     studentName?, tutorName?, lastMessage?, lastMessageAt?, lastSenderId?
//     createdAt, updatedAt
//     Participants only. Admins do NOT read conversations or messages by default.
//
//   conversations/{conversationId}/messages/{messageId}
//     senderId, text, createdAt
//     Max 2000 chars. senderId must equal auth.uid. Blocked pairs cannot write.
//
//   messageRateLimits/{userId}          // per-sender send ticket (3s / 12 per 60s)
//     lastSentAt, windowStartedAt, windowCount
//     Message create requires a ticket newer than 15s. Owner-only read/write.
//
//   userBlocks/{blockerId}_{blockedId}
//     blockerId, blockedId, createdAt
//     Either participant may get a specific pair; only the blocker may list/delete.
//
//   conversationReports/{conversationId}_{reporterId}
//     conversationId, reporterId, reportedUserId, reason, details, status, createdAt
//     Reporter reads own reports. Admins may list/update report metadata only.
//     This is the explicit moderation path — not conversation/message access.
//
//   asaasWebhookReceipts/{receiptId}    // Admin SDK only (Asaas webhook idempotency)
//     paymentId?, asaasCheckoutId?, bookingId?, event, outcome, createdAt
//
//   payments/{paymentId}                // Financial ledger (Admin SDK writes)
//     paymentId === "{provider}_{providerPaymentId}"
//     bookingId, studentId, tutorId, provider, providerPaymentId
//     grossAmount, platformFee, paymentProcessingFee, netPlatformRevenue
//     tutorGrossAmount, tutorPayoutAmount
//     status: pending | checkout_created | paid | failed | refunded | cancelled | expired
//     createdAt, paidAt?, refundedAt?
//     Readable by the booking student, tutor, or admin. Client writes denied.
//
//   tutorPayouts/{payoutId}             // Tutor disbursement batches (Admin SDK writes)
//     payoutId, tutorId, bookingId, amount, status: pending | processing | paid | failed | cancelled
//     paymentIds[] (ledger payment document ids), createdAt?, paidAt?
//     Readable by the tutor or admin. Client writes denied. Queued after lesson completion.
//
//   facilitators/{facilitatorId}        // Referral partners (Admin SDK writes; facilitator reads own)
//     userId, referralCode, displayName, email, phone?, cpf?, commissionRatePercent
//     status: active | suspended, stats: { clicks, signups, activeUsers, paidBookings }
//
//   referrals/{referralId}              // referralId === referred userId (Admin SDK writes)
//     facilitatorId, referralCode, userId, userEmail, userPhone?, userCpf?
//     status: active | rejected | flagged, source, attributedAt
//
//   commissions/{commissionId}          // commissionId === booking_{bookingId}
//     facilitatorId, referralId, studentId, bookingId, paymentId, grossAmount, platformFee
//     commissionAmount, status: pending | locked | approved | available | paid | reversed
//
//   facilitatorPayouts/{payoutId}       // Facilitator disbursement batches (Admin SDK writes)
//     facilitatorId, commissionIds[], amount, status: pending | approved | paid | cancelled
//
//   facilitatorReferralFlags/{flagId}   // Anti-fraud identity flags (Admin SDK only)
//     facilitatorId, identityKey, reason, createdAt
//
//   adminAuditLogs/{logId}              // Admin SDK only (privileged admin actions)
//   emailOutbox/{emailId}               // Admin SDK only (transactional email outbox)
//     actorUid, action, targetType?, targetId?, metadata, createdAt
//
//   lessonSlots/{slotId}                // Admin SDK only (individual uniqueness lock)
//     slotId === tutorId + "_" + scheduledAt (UTC ISO)
//     tutorId, scheduledAt, scheduledAtIso, bookingId, studentId
//     status: held, type: individual, updatedAt
//
// NOTE: These rules are a starting point. Validate with the Firebase Emulator
// Suite before deploying to production.
//
// ---------------------------------------------------------------------------
// App write-path audit (MVP — fix app/admin flows; do not loosen rules here)
// ---------------------------------------------------------------------------
// MATCH  users/{uid} create          → lib/auth/service.ts (signup; role student|tutor only)
// MATCH  users/{uid} update          → lib/storage/service.ts (photoUrl, updatedAt)
// MATCH  users/{uid}/public/profile  → lib/auth/service.ts, lib/storage/service.ts, AuthContext
// READ   users/{uid}                 → owner or admin only (email + role stay private)
// READ   users/{uid}/public/profile  → authenticated (displayName + photoUrl only)
// ADMIN  users/{uid} get/list        → admin dashboard via Admin SDK / client admin
// DENY   users/{uid} get by peer     → student/tutor cannot read another account doc
// ADMIN  bookings create (individual)  → POST /api/bookings
//        Hostinger Express: server/api/bookings.js
//        Vercel / next start: app/api/bookings + lib/bookings/server.ts
//        Transaction: occupancy query (pending|confirmed) + lessonSlots/{tutorId}_{scheduledAtISO}
//        immediately before commit. Cancelled releases the slot; completed stays historical.
// ADMIN  bookings create (collective) → POST /api/hubs/join
//        Hostinger Express: server/api/hubs.js
//        Vercel / next start: app/api/hubs/join + lib/hubs/join-and-book.js
//        Price is hub.currentPrice. Client booking create is denied.
// DENY   bookings create             → clients cannot write financial booking records
// MATCH  bookings student cancel       → unpaid client update; paid via /api/bookings/cancel + refund
//        (role from uid vs studentId/tutorId; browser actor field is ignored)
// MATCH  bookings tutor accept payment → lib/bookings/service.ts (paymentStatus, updatedAt)
// ADMIN  bookings checkout (Asaas)     → lib/payments/create-checkout.ts
//        (asaasCheckoutId, asaasCheckoutExpiresAt, checkoutLockUntil, fee split)
// ADMIN  bookings confirm (webhook)    → lib/payments/process-webhook.ts
//        (asaasWebhookReceipts + booking write in one Admin transaction; e-mail after commit)
// ADMIN  payments ledger (webhook)     → lib/payments/process-payment-webhook.ts
//        (paymentWebhookReceipts + payments/{paymentId} + booking in one Admin transaction)
// ADMIN  tutorPayouts                  → lib/payments/tutor-payouts.ts after lesson completion
// ADMIN  tutorPayouts mark paid        → POST /api/admin/tutor-payouts/mark-paid
// ADMIN  bookings lesson reminder      → lib/notifications (lessonReminderSentAt)
// MATCH  bookings tutor cancel         → unpaid client-capable; paid via /api/bookings/cancel + refund
// ADMIN  bookings tutor complete       → POST /api/bookings/complete
//        Hostinger Express: server/api/bookings.js
//        Vercel / next start: app/api/bookings/complete + lib/bookings/server.ts
//        Only the booking tutor or an admin; confirmed + paid only; sets completedAt
// MATCH  bookings tutor complete       → hardened rules (same transition as the API)
// MATCH  collectiveHubs create         → lib/hubs/service.ts (approved tutor dashboard; no roster)
// ADMIN  collectiveHubs student join   → POST /api/hubs/join (participant doc + count)
//        Hostinger Express: server/api/hubs.js
//        Vercel / next start: app/api/hubs/join + lib/hubs/join-and-book.js
// DENY   collectiveHubs student update → clients cannot add themselves or edit price/roster
// READ   collectiveHubs                → public marketplace fields + occupancy count
// READ   collectiveHubs/.../participants → student self, owning tutor, or admin
// MATCH  tutors/{tutorId}/availability  → lib/availability/service.ts (tutor dashboard)
// READ   bookings (own records only)    → students: studentId == uid; tutors: tutorId == uid; admin: all
// ADMIN  bookings occupancy             → GET /api/bookings/occupancy (slot picker; ISO start times only)
// MATCH  conversations create        → lib/conversations/service.ts (student starts thread)
// MATCH  conversations update        → lib/conversations/service.ts (lastMessage preview)
// MATCH  conversations/messages create → lib/conversations/service.ts (either participant)
// MATCH  messageRateLimits           → lib/conversations/service.ts (send ticket)
// MATCH  userBlocks                  → lib/conversations/service.ts (block / unblock)
// MATCH  conversationReports         → lib/conversations/service.ts (participant report)
//        Admin may read/update report metadata only — never conversation messages.
// ADMIN  reviews create              → POST /api/reviews (deterministic id = bookingId)
//        Hostinger Express: server/api/reviews.js (firebase-admin; bypasses rules)
//        Vercel / next start: app/api/reviews + lib/reviews/server.ts
//        Client: lib/reviews/client.ts (never writes reviews from the browser)
// MATCH  reviews create              → hardened rules (completed booking, student + tutor match)
// ADMIN  tutors rating/reviewCount   → POST /api/reviews after a valid create
//        (server uses the booking tutorId). Admin-only POST /recompute-rating
//        for moderation/recalculation. Students and tutors cannot set rating
//        or reviewCount, delete reviews, or recompute another tutor.
// ADMIN  account delete + anonymize  → POST /api/account/delete (LGPD art. 18)
//        Deletes users/{uid}; anonymizes bookings/reviews (keeps docs for integrity)
//        Hostinger Express: server/api/account.js
//        Vercel / next start: app/api/account/delete + lib/account/server.ts
// ADMIN  seed data                     → scripts/seed.ts
// MATCH  tutors/{tutorId} create     → lib/tutors/service.ts (onboarding; isVerified false, pending)
// MATCH  tutors/{tutorId} update     → lib/tutors/service.ts (avatarUrl, credentialFileName)
// ADMIN  operations dashboard        → GET /api/admin/dashboard (admin-only; Hostinger + Next)
//        Counts and payment totals stay on the server. Browser never lists
//        users/bookings for the dashboard.
// ADMIN  adminAuditLogs              → written after tutor review (Admin SDK only)
// ADMIN  tutors verification review  → POST /api/tutors/review (admin-only; Hostinger + Next)
// MATCH  tutors verification resubmit → POST /api/tutors/resubmit (tutor-only, changes_requested|rejected → pending)
// MATCH  Storage credentials         → lib/storage/service.ts (tutors/{id}/credentials/*)
// =============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // -------------------------------------------------------------------------
    // Helper functions
    // -------------------------------------------------------------------------

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function userExists() {
      return isAuthenticated()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function userRole() {
      return userDoc().data.role;
    }

    function isAdmin() {
      return userExists() && userRole() == "admin";
    }

    function isTutor() {
      return userExists() && userRole() == "tutor";
    }

    function isStudent() {
      return userExists() && userRole() == "student";
    }

    function isVerifiedTutor(tutorId) {
      let tutor = get(/databases/$(database)/documents/tutors/$(tutorId)).data;
      return tutor.isVerified == true
        && (!("verificationStatus" in tutor) || tutor.verificationStatus == "approved");
    }

    function verificationFieldsLocked() {
      return !request.resource.data.diff(resource.data).affectedKeys()
        .hasAny([
          "isVerified",
          "verificationStatus",
          "reviewedAt",
          "reviewedBy",
          "verificationReason"
        ]);
    }

    function tutorOwnedByAuth(tutorId) {
      return isAuthenticated()
        && get(/databases/$(database)/documents/tutors/$(tutorId)).data.userId == request.auth.uid;
    }

    function validRating() {
      return request.resource.data.rating in [1, 2, 3, 4, 5];
    }

    function unchanged(field) {
      return request.resource.data[field] == resource.data[field];
    }

    function hubOccupancy(data) {
      return data.confirmedStudentCount is number
        ? data.confirmedStudentCount
        : 0;
    }

    function tutorOwnsHub() {
      return isAuthenticated()
        && resource.data.tutorId == request.auth.uid
        && tutorOwnedByAuth(resource.data.tutorId);
    }

    function tutorOwnsParentHub(hubId) {
      return isAuthenticated()
        && exists(/databases/$(database)/documents/collectiveHubs/$(hubId))
        && get(/databases/$(database)/documents/collectiveHubs/$(hubId)).data.tutorId
          == request.auth.uid
        && tutorOwnedByAuth(
          get(/databases/$(database)/documents/collectiveHubs/$(hubId)).data.tutorId
        );
    }

    function tutorUpdatingOwnHub() {
      return tutorOwnsHub()
        && unchanged("tutorId")
        && unchanged("confirmedStudentCount")
        && (!("confirmedStudentIds" in request.resource.data)
          || unchanged("confirmedStudentIds"))
        && request.resource.data.maxStudents is int
        && request.resource.data.maxStudents >= 2
        && request.resource.data.maxStudents <= 20
        && request.resource.data.maxStudents >= hubOccupancy(resource.data)
        && request.resource.data.status in ["open", "full", "closed", "cancelled"]
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly([
            "title", "description", "maxStudents", "currentPrice", "fullPrice",
            "schedule", "modality", "status", "subject", "tutorName",
            "scheduledDate", "startTime", "individualPrice", "updatedAt"
          ]);
    }

    function approvedTutorCreatingHub() {
      let data = request.resource.data;

      return isTutor()
        && isVerifiedTutor(request.auth.uid)
        && data.tutorId == request.auth.uid
        && data.maxStudents is int
        && data.maxStudents >= 2
        && data.maxStudents <= 20
        && data.confirmedStudentCount == 0
        && !("confirmedStudentIds" in data)
        && data.status == "open"
        && data.currentPrice is number
        && data.currentPrice > 0
        && data.title is string
        && data.title.size() > 0;
    }

    function validAvailabilityDoc() {
      let data = request.resource.data;

      return data.keys().hasOnly(["slots", "updatedAt"])
        && data.slots is list
        && data.slots.size() <= 42;
    }

    function conversationParticipants() {
      return resource.data.participantIds;
    }

    function isConversationParticipant() {
      return isAuthenticated() && request.auth.uid in conversationParticipants();
    }

    function usersBlocked(userA, userB) {
      return exists(/databases/$(database)/documents/userBlocks/$(userA + '_' + userB))
        || exists(/databases/$(database)/documents/userBlocks/$(userB + '_' + userA));
    }

    function senderCooldownOk(conv) {
      return !("lastSenderId" in conv)
        || !("lastMessageAt" in conv)
        || conv.lastSenderId != request.auth.uid
        || request.time >= conv.lastMessageAt + duration.value(3, 's');
    }

    function hasFreshSendSlot() {
      let ratePath = /databases/$(database)/documents/messageRateLimits/$(request.auth.uid);
      return exists(ratePath)
        && request.time < get(ratePath).data.lastSentAt + duration.value(15, 's');
    }

    function validConversationCreate() {
      let data = request.resource.data;

      return isStudent()
        && data.studentId == request.auth.uid
        && data.tutorId is string
        && data.studentId != data.tutorId
        && data.participantIds is list
        && data.participantIds.size() == 2
        && data.studentId in data.participantIds
        && data.tutorId in data.participantIds
        && exists(/databases/$(database)/documents/tutors/$(data.tutorId))
        && !usersBlocked(data.studentId, data.tutorId);
    }

    function validConversationUpdate() {
      return isConversationParticipant()
        && unchanged("studentId")
        && unchanged("tutorId")
        && unchanged("participantIds")
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(["lastMessage", "lastMessageAt", "updatedAt", "lastSenderId"])
        && (!("lastSenderId" in request.resource.data)
          || request.resource.data.lastSenderId == request.auth.uid)
        && !usersBlocked(resource.data.studentId, resource.data.tutorId)
        && senderCooldownOk(resource.data);
    }

    function validRateLimitCreate(userId) {
      let data = request.resource.data;

      return isOwner(userId)
        && data.keys().hasOnly(["lastSentAt", "windowStartedAt", "windowCount"])
        && data.lastSentAt is timestamp
        && data.windowStartedAt is timestamp
        && data.windowCount == 1;
    }

    function validRateLimitUpdate(userId) {
      let before = resource.data;
      let after = request.resource.data;
      let cooldownOk = request.time >= before.lastSentAt + duration.value(3, 's');
      let newWindow = after.windowCount == 1
        && after.windowStartedAt != before.windowStartedAt
        && request.time >= before.windowStartedAt + duration.value(60, 's');
      let sameWindow = after.windowCount == before.windowCount + 1
        && after.windowCount <= 12
        && after.windowStartedAt == before.windowStartedAt
        && request.time < before.windowStartedAt + duration.value(60, 's');

      return isOwner(userId)
        && after.keys().hasOnly(["lastSentAt", "windowStartedAt", "windowCount"])
        && after.lastSentAt is timestamp
        && after.windowStartedAt is timestamp
        && cooldownOk
        && (newWindow || sameWindow);
    }

    function validUserBlockCreate(blockId) {
      let data = request.resource.data;

      return isAuthenticated()
        && data.blockerId == request.auth.uid
        && data.blockedId is string
        && data.blockedId.size() > 0
        && data.blockedId != request.auth.uid
        && blockId == data.blockerId + '_' + data.blockedId
        && data.createdAt is timestamp
        && data.keys().hasOnly(["blockerId", "blockedId", "createdAt"]);
    }

    function validConversationReportCreate(reportId) {
      let data = request.resource.data;
      let conv = get(/databases/$(database)/documents/conversations/$(data.conversationId)).data;

      return isAuthenticated()
        && exists(/databases/$(database)/documents/conversations/$(data.conversationId))
        && request.auth.uid in conv.participantIds
        && data.reporterId == request.auth.uid
        && data.reportedUserId in conv.participantIds
        && data.reportedUserId != request.auth.uid
        && reportId == data.conversationId + '_' + request.auth.uid
        && data.reason in ["harassment", "spam", "off_platform", "other"]
        && data.status == "open"
        && data.details is string
        && data.details.size() <= 1000
        && data.createdAt is timestamp
        && data.keys().hasOnly([
          "conversationId", "reporterId", "reportedUserId", "reason",
          "details", "status", "createdAt"
        ]);
    }

    function validConversationReportAdminUpdate() {
      return isAdmin()
        && unchanged("conversationId")
        && unchanged("reporterId")
        && unchanged("reportedUserId")
        && unchanged("reason")
        && unchanged("details")
        && unchanged("createdAt")
        && request.resource.data.status in ["open", "reviewed", "dismissed"]
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(["status", "reviewedAt", "reviewedBy"]);
    }

    function validUserCreate(userId) {
      let data = request.resource.data;

      return isOwner(userId)
        && data.keys().hasAll(["role", "displayName", "email", "createdAt"])
        && data.keys().hasOnly([
          "role", "displayName", "email", "photoUrl", "createdAt", "updatedAt"
        ])
        && data.role in ["student", "tutor"]
        && data.email == request.auth.token.email;
    }

    function validUserSelfUpdate(userId) {
      return isOwner(userId)
        && unchanged("role")
        && unchanged("email")
        && unchanged("createdAt")
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(["displayName", "photoUrl", "updatedAt"]);
    }

    function validPublicProfileWrite() {
      let data = request.resource.data;

      return data.keys().hasAll(["displayName"])
        && data.keys().hasOnly(["displayName", "photoUrl", "updatedAt"])
        && data.displayName is string
        && data.displayName.size() > 0
        && data.displayName.size() <= 120
        && (!("photoUrl" in data) || data.photoUrl == null || data.photoUrl is string);
    }

    function validTutorCreate(tutorId) {
      let data = request.resource.data;

      return isTutor()
        && isOwner(tutorId)
        && data.userId == request.auth.uid
        && data.isVerified == false
        && data.keys().hasAll([
          "userId", "name", "subject", "individualPrice", "collectivePrice", "createdAt"
        ])
        && data.keys().hasOnly([
          "userId", "name", "subject", "city", "state", "bio", "about", "methodology",
          "headline", "individualPrice", "collectivePrice", "modality", "lessonTypes",
          "isVerified", "verificationStatus", "isOnline", "rating", "reviewCount",
          "avatarUrl", "avatarColor", "credentialFileName", "educationLevels",
          "yearsOfExperience", "hasAvailability", "createdAt", "updatedAt"
        ])
        && (!("verificationStatus" in data) || data.verificationStatus == "pending")
        && !("reviewedAt" in data)
        && !("reviewedBy" in data)
        && (!("rating" in data) || data.rating == 0)
        && (!("reviewCount" in data) || data.reviewCount == 0);
    }

    function validTutorSelfUpdate(tutorId) {
      return isTutor()
        && tutorOwnedByAuth(tutorId)
        && unchanged("userId")
        && unchanged("rating")
        && unchanged("reviewCount")
        && verificationFieldsLocked()
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly([
            "name", "subject", "city", "state", "bio", "about", "methodology", "headline",
            "individualPrice", "collectivePrice", "modality", "lessonTypes", "isOnline",
            "avatarUrl", "avatarColor", "credentialFileName", "educationLevels",
            "yearsOfExperience", "hasAvailability", "updatedAt"
          ]);
    }

    // -------------------------------------------------------------------------
    // users
    // -------------------------------------------------------------------------

    match /users/{userId} {
      // Private account: email, role, timestamps. Not readable by peers.
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isOwner(userId) || isAdmin();

      allow create: if validUserCreate(userId);

      allow update: if isAdmin() || validUserSelfUpdate(userId);

      allow delete: if isAdmin();

      match /public/{docId} {
        allow get: if isAuthenticated() && docId == "profile";
        allow list: if false;

        allow create, update: if (isOwner(userId) || isAdmin())
          && docId == "profile"
          && validPublicProfileWrite();

        allow delete: if isAdmin() && docId == "profile";
      }
    }

    // -------------------------------------------------------------------------
    // tutors (public profiles)
    // -------------------------------------------------------------------------

    match /tutors/{tutorId} {
      // Marketplace listing is public for verified tutors only. Owners and admins
      // can still read pending/rejected/suspended profiles. Private fields
      // (credentialFileName, review meta) are omitted from public mappers.
      allow get: if resource.data.isVerified == true
        || (isAuthenticated() && resource.data.userId == request.auth.uid)
        || isAdmin();

      allow list: if isAdmin() || resource.data.isVerified == true;

      allow create: if validTutorCreate(tutorId);

      // Admin-only: isVerified, verificationStatus, reviewedAt, reviewedBy,
      // verificationReason, rating, reviewCount, hoursTaught, studentsServed.
      allow update: if isAdmin() || validTutorSelfUpdate(tutorId);

      allow delete: if isAdmin();

      match /availability/{docId} {
        allow read: if true;

        allow create, update: if isTutor()
          && tutorOwnedByAuth(tutorId)
          && validAvailabilityDoc();

        allow delete: if tutorOwnedByAuth(tutorId) || isAdmin();
      }
    }

    // -------------------------------------------------------------------------
    // collectiveHubs (turmas abertas)
    // -------------------------------------------------------------------------

    match /collectiveHubs/{hubId} {
      // Public marketplace: title, tutor, schedule, price, occupancy count.
      // Student ids live only under /participants.
      allow read: if true;

      allow create: if approvedTutorCreatingHub();

      allow update: if tutorUpdatingOwnHub() || isAdmin();

      allow delete: if tutorOwnsHub() || isAdmin();

      match /participants/{studentId} {
        allow get: if isOwner(studentId) || tutorOwnsParentHub(hubId) || isAdmin();
        allow list: if tutorOwnsParentHub(hubId) || isAdmin();
        allow create, update, delete: if false;
      }
    }

    // -------------------------------------------------------------------------
    // bookings
    // -------------------------------------------------------------------------

    match /bookings/{bookingId} {
      // Own records only. Occupancy for the public slot picker is served by
      // GET /api/bookings/occupancy (Admin SDK) and never exposes booking docs.
      allow read: if isAuthenticated()
        && (resource.data.studentId == request.auth.uid
          || resource.data.tutorId == request.auth.uid
          || isAdmin());

      // Financial fields (price, platformFee, tutorAmount) are written only by
      // Admin SDK booking APIs. Clients cannot create or price a booking.
      allow create: if false;

      allow update: if isAdmin()
        || (resource.data.studentId == request.auth.uid
          && request.resource.data.status == "cancelled"
          && resource.data.status in ["pending", "confirmed"]
          && !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(["price", "platformFee", "tutorAmount", "hubId"])
          && (!("paymentStatus" in resource.data)
            || resource.data.paymentStatus != "paid"))
        || (resource.data.tutorId == request.auth.uid
          && resource.data.status == "pending"
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(["paymentStatus", "updatedAt"])
          && request.resource.data.paymentStatus == "awaiting_payment"
          && unchanged("status"))
        || (resource.data.tutorId == request.auth.uid
          && resource.data.status in ["pending", "confirmed"]
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(["status", "updatedAt", "meetingUrl"])
          && request.resource.data.status == "cancelled"
          && (!("paymentStatus" in resource.data)
            || resource.data.paymentStatus != "paid"))
        || (resource.data.tutorId == request.auth.uid
          && resource.data.status == "confirmed"
          && resource.data.paymentStatus == "paid"
          && resource.data.scheduledAt <= request.time
          && request.resource.data.status == "completed"
          && request.resource.data.completedAt is timestamp
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(["status", "updatedAt", "completedAt"]));

      allow delete: if isAdmin();
    }

    // -------------------------------------------------------------------------
    // reviews
    // -------------------------------------------------------------------------

    match /reviews/{reviewId} {
      function reviewBooking() {
        return get(/databases/$(database)/documents/bookings/$(request.resource.data.bookingId)).data;
      }

      function validReviewCreate() {
        let data = request.resource.data;
        let booking = reviewBooking();

        return isStudent()
          && reviewId == data.bookingId
          && data.studentId == request.auth.uid
          && data.tutorId == booking.tutorId
          && data.bookingId is string
          && data.bookingId.size() > 0
          && data.comment is string
          && data.comment.size() > 0
          && data.comment.size() <= 2000
          && data.createdAt is timestamp
          && validRating()
          && exists(/databases/$(database)/documents/bookings/$(data.bookingId))
          && booking.studentId == request.auth.uid
          && booking.status == "completed";
      }

      function validReviewUpdate() {
        return isAuthenticated()
          && resource.data.studentId == request.auth.uid
          && unchanged("bookingId")
          && unchanged("tutorId")
          && unchanged("studentId")
          && validRating()
          && request.resource.data.comment is string
          && request.resource.data.comment.size() > 0
          && request.resource.data.comment.size() <= 2000
          && request.time < resource.data.createdAt + duration.value(48, "h");
      }

      allow read: if true;

      allow create: if validReviewCreate();

      allow update: if isAdmin() || validReviewUpdate();

      allow delete: if isAdmin();
    }

    // -------------------------------------------------------------------------
    // conversations (student ↔ tutor) and messages
    // -------------------------------------------------------------------------

    match /conversations/{conversationId} {
      function conversationParent() {
        return get(/databases/$(database)/documents/conversations/$(conversationId)).data;
      }

      function isMessageParticipant() {
        return isAuthenticated()
          && request.auth.uid in conversationParent().participantIds;
      }

      function validMessageCreate() {
        let data = request.resource.data;
        let conv = conversationParent();

        return isMessageParticipant()
          && data.senderId == request.auth.uid
          && data.text is string
          && data.text.size() > 0
          && data.text.size() <= 2000
          && data.keys().hasAll(["senderId", "text"])
          && data.keys().hasOnly(["senderId", "text", "createdAt"])
          && (!("createdAt" in data) || data.createdAt is timestamp)
          && !usersBlocked(conv.studentId, conv.tutorId)
          && senderCooldownOk(conv)
          && hasFreshSendSlot();
      }

      // Participants only. Admins are intentionally excluded from conversation
      // and message reads. Moderation uses conversationReports metadata.
      allow read: if isConversationParticipant();

      allow create: if validConversationCreate();

      allow update: if validConversationUpdate();

      allow delete: if false;

      match /messages/{messageId} {
        allow read: if isMessageParticipant();

        allow create: if validMessageCreate();

        allow update, delete: if false;
      }
    }

    // -------------------------------------------------------------------------
    // messageRateLimits (per-sender send tickets)
    // -------------------------------------------------------------------------

    match /messageRateLimits/{userId} {
      allow get: if isOwner(userId);

      allow create: if validRateLimitCreate(userId);

      allow update: if validRateLimitUpdate(userId);

      allow delete: if false;
    }

    // -------------------------------------------------------------------------
    // userBlocks (either participant may inspect a pair; only blocker writes)
    // -------------------------------------------------------------------------

    match /userBlocks/{blockId} {
      // Path-based get so a missing pair returns empty instead of
      // permission-denied. UIDs are matched as the blocker or blocked suffix.
      allow get: if isAuthenticated()
        && (blockId.matches('^' + request.auth.uid + '_.+')
          || blockId.matches('.+_' + request.auth.uid + '$'));

      allow list: if isAuthenticated()
        && resource.data.blockerId == request.auth.uid;

      allow create: if validUserBlockCreate(blockId);

      allow delete: if isAuthenticated()
        && resource.data.blockerId == request.auth.uid;

      allow update: if false;
    }

    // -------------------------------------------------------------------------
    // conversationReports (explicit admin moderation metadata — not messages)
    // -------------------------------------------------------------------------

    match /conversationReports/{reportId} {
      allow get: if isAuthenticated()
        && (resource.data.reporterId == request.auth.uid || isAdmin());

      allow list: if isAdmin()
        || (isAuthenticated() && resource.data.reporterId == request.auth.uid);

      allow create: if validConversationReportCreate(reportId);

      allow update: if validConversationReportAdminUpdate();

      allow delete: if false;
    }

    // -------------------------------------------------------------------------
    // subjects (read-only catalog)
    // -------------------------------------------------------------------------

    match /subjects/{subjectId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Asaas webhook receipts — Admin SDK only (lib/payments/process-webhook.ts)
    match /asaasWebhookReceipts/{receiptId} {
      allow read, write: if false;
    }

    // Mercado Pago webhook receipts — Admin SDK only (lib/payments/process-mercadopago-webhook.ts)
    match /mercadopagoWebhookReceipts/{receiptId} {
      allow read, write: if false;
    }

    // Unified payment webhook receipts — Admin SDK only (lib/payments/process-payment-webhook.ts)
    match /paymentWebhookReceipts/{receiptId} {
      allow read, write: if false;
    }

    // Financial ledger — Admin SDK writes; participants read own records
    match /payments/{paymentId} {
      allow read: if isAuthenticated()
        && (resource.data.studentId == request.auth.uid
          || resource.data.tutorId == request.auth.uid
          || isAdmin());
      allow write: if false;
    }

    // Tutor payout batches — Admin SDK writes; tutor reads own payouts
    match /tutorPayouts/{payoutId} {
      allow read: if isAuthenticated()
        && (resource.data.tutorId == request.auth.uid || isAdmin());
      allow write: if false;
    }

    // Facilitator program — Admin SDK writes; facilitator reads own records
    match /facilitators/{facilitatorId} {
      allow read: if isAuthenticated()
        && (facilitatorId == request.auth.uid || isAdmin());
      allow write: if false;
    }

    match /referrals/{referralId} {
      allow read: if isAuthenticated()
        && (referralId == request.auth.uid
          || resource.data.facilitatorId == request.auth.uid
          || isAdmin());
      allow write: if false;
    }

    match /commissions/{commissionId} {
      allow read: if isAuthenticated()
        && (resource.data.facilitatorId == request.auth.uid || isAdmin());
      allow write: if false;
    }

    match /facilitatorPayouts/{payoutId} {
      allow read: if isAuthenticated()
        && (resource.data.facilitatorId == request.auth.uid || isAdmin());
      allow write: if false;
    }

    match /facilitatorReferralFlags/{flagId} {
      allow read, write: if false;
    }

    // Admin action audit trail — Admin SDK only (lib/admin/audit.js)
    match /adminAuditLogs/{logId} {
      allow read, write: if false;
    }

    // Transactional email outbox — Admin SDK only (lib/email/outbox)
    match /emailOutbox/{emailId} {
      allow read, write: if false;
    }

    // JetSend delivery webhook receipts — Admin SDK only (lib/email/jetsend-webhook)
    match /emailDeliveryEvents/{eventId} {
      allow read, write: if false;
    }

    // Individual lesson uniqueness lock — Admin SDK only
    // (lib/bookings/create-booking.js). Clients cannot read or write.
    match /lessonSlots/{slotId} {
      allow read, write: if false;
    }

    // -------------------------------------------------------------------------
    // Deny everything else by default
    // -------------------------------------------------------------------------

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
