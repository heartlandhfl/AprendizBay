{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "outDir": "dist-server",
    "rootDir": "server",
    "declaration": false,
    "noEmit": false,
    "types": ["node"]
  },
  "include": ["server/attach-next.ts", "server/api/**/*.ts"]
}
