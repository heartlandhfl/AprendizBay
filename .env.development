# =============================================================================
# WARNING: THIS FILE IS NOT LOADED BY ANY CODE PATH
# server.js only loads .env.local via dotenv. Hostinger/Vercel use panel vars.
# Use this file as a reference when copying vars into your hosting panel.
# =============================================================================
#
# Aprendiz Bay — development (local)
# Firebase project: aprendiz-bay-dev
# Site: http://localhost:3000
#
# For local work, copy this file to .env.local and fill in secrets:
#   cp .env.development .env.local

# --- Firebase (client) ---
# Firebase Console → Project settings → Your apps → Web app
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=aprendiz-bay-dev
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Firebase Admin (server) ---
# Service accounts → Generate new private key
FIREBASE_ADMIN_PROJECT_ID=aprendiz-bay-dev
FIREBASE_ADMIN_CLIENT_EMAIL=
# Paste private_key on one line with \n escapes
FIREBASE_ADMIN_PRIVATE_KEY=

# --- Site URL ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Asaas (sandbox) ---
# Quote ASAAS_API_KEY if it starts with $
ASAAS_API_KEY=
ASAAS_ENVIRONMENT=sandbox
ASAAS_WEBHOOK_TOKEN=

# --- Mercado Pago (test credentials) ---
# Developers → Your integrations → Test credentials
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY=

# --- Transactional e-mail ---
# EMAIL_ENV controls recipient safety: development | staging | production
EMAIL_ENV=development
# Required in development/staging. All non-production sends are redirected here unless allowlisted.
EMAIL_TEST_RECIPIENT=
# Optional comma-separated allowlist for staging only.
# EMAIL_STAGING_ALLOWLIST=qa@example.com,team@example.com
EMAIL_PROVIDER=jetsend
# JetSend — https://app.jetsend.com → Account → API Details
JET_SEND_API_KEY=
# JETSEND_API_KEY=
JETSEND_FROM_EMAIL=Aprendiz Bay <noreply@aprendizbay.com.br>
# Optional: tenant metadata from JetSend dashboard (for ops reference)
JETSEND_TENANT_ID=
JETSEND_SLUG=
# Optional: verified tracking domain from JetSend (e.g. app-tracking@aprendizbay.com.br)
JETSEND_TRACKING_DOMAIN=
# Legacy fallbacks if JetSend is unset:
# RESEND_API_KEY=
# SENDGRID_API_KEY=
EMAIL_FROM=Aprendiz Bay <noreply@aprendizbay.com.br>
NOTIFICATIONS_CRON_SECRET=

# --- Platform fee ---
PLATFORM_FEE_PERCENT=10
NEXT_PUBLIC_PLATFORM_FEE_PERCENT=10

# --- Payment provider ---
# asaas (default) | mercadopago
PAYMENT_PROVIDER=asaas

# --- Observability (optional) ---
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
NEXT_PUBLIC_SENTRY_ENVIRONMENT=development
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
PLAUSIBLE_DOMAIN=

# --- Local-only flags (never honored when NODE_ENV=production) ---
# ENABLE_MOCK_TUTORS=true
# NEXT_PUBLIC_ENABLE_MOCK_TUTORS=true
# ALLOW_DEV_SEED=true
