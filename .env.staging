# Aprendiz Bay — staging
# Firebase project: aprendiz-bay-staging
# Site: https://staging.aprendizbay.com.br
#
# Copy variable names and values into Vercel → Project → Settings → Environment Variables
# scoped to Preview (and/or a dedicated staging branch). Do not commit real secrets here.

# --- Firebase (client) ---
# Firebase Console → aprendiz-bay-staging → Project settings → Your apps → Web app
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=aprendiz-bay-staging
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Firebase Admin (server) ---
# aprendiz-bay-staging → Service accounts → Generate new private key
FIREBASE_ADMIN_PROJECT_ID=aprendiz-bay-staging
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# --- Site URL ---
NEXT_PUBLIC_SITE_URL=https://staging.aprendizbay.com.br

# --- Asaas (sandbox recommended for staging) ---
ASAAS_API_KEY=
ASAAS_ENVIRONMENT=sandbox
# Webhook URL: https://staging.aprendizbay.com.br/api/payments/webhook
ASAAS_WEBHOOK_TOKEN=

# --- Mercado Pago (test/sandbox credentials) ---
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
# Webhook URL: https://staging.aprendizbay.com.br/api/mercadopago/webhook
NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY=

# --- Transactional e-mail ---
EMAIL_ENV=staging
EMAIL_TEST_RECIPIENT=
# EMAIL_STAGING_ALLOWLIST=qa@example.com
# Use EMAIL_PROVIDER=jetsend with a staging JetSend key and verified sender.
EMAIL_PROVIDER=jetsend
JETSEND_API_KEY=
JETSEND_FROM_EMAIL=Aprendiz Bay <noreply@aprendizbay.com.br>
# Optional JetSend staging API override
# JETSEND_STAGING_API_URL=https://app.jetsend.com/api/v1/transmission/email
JETSEND_TENANT_ID=
JETSEND_SLUG=
JETSEND_TRACKING_DOMAIN=
# RESEND_API_KEY=
# SENDGRID_API_KEY=
EMAIL_FROM=Aprendiz Bay <noreply@aprendizbay.com.br>
NOTIFICATIONS_CRON_SECRET=

# --- Platform fee ---
PLATFORM_FEE_PERCENT=10
NEXT_PUBLIC_PLATFORM_FEE_PERCENT=10

# --- Payment provider ---
# asaas | mercadopago
PAYMENT_PROVIDER=mercadopago

# --- Observability (optional) ---
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
SENTRY_ENVIRONMENT=staging
NEXT_PUBLIC_SENTRY_ENVIRONMENT=staging
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
PLAUSIBLE_DOMAIN=
